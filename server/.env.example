# ============================================
# JARVIS 环境变量模板
# 复制本文件为 .env 并填入你的真实 API Key
#   cp .env.example .env
# ============================================

# LLM API 配置
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://apihub.agnes-ai.com/v1
LLM_MODEL=agnes-2.0-flash

# HuggingFace 镜像（中国网络加速，可选）
HF_ENDPOINT=https://hf-mirror.com
