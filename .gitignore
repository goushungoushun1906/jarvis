# GitHub 上已忽略（不会被提交）
# ============================================================

# === 敏感配置 ===
server/.env
server/backend-dist/.env

# === 数据库（含对话历史和 AI 记忆，本地运行时需要） ===
server/*.db
server/*.db-wal
server/*.db-shm
!server/jarvis-db.enc  # 加密备份文件会提交

# === 打包产物 ===
server/backend-dist/
server/dist/
server/build/
dist/
build/
release/
# electron-builder 换名输出的目录（覆盖已存在的产物目录会被批量删除策略拦下，
# 因此每次构建换一个新目录名，这里统一忽略）
release-new/
release-b*/
release-old-*/
release-*/
**/*.exe

# === 虚拟环境 ===
server/.venv/
# 依赖收敛验证用的临时 venv（全新空环境跑 pip install + pytest）
server/.venv-fresh/
server/.venv-clean/
server/.venv-lock/
server/.venv-final/
server/fresh_install.log
server/clean_install.log
server/lock_install.log
server/final_install.log
server/__pycache__/
server/**/*.pyc
**/__pycache__/
**/*.pyc
**/*.pyo

# === Node 环境 ===
node_modules/
**/node_modules/
**/.cache/
**/.vite/

# === Electron 缓存 ===
.electron-data/
**/.electron-gyp/

# === 日志 ===
**/*.log
logs/

# === Python 构建 ===
**/*.egg-info/
**/.eggs/
*.egg

# === OS 文件 ===
.DS_Store
Thumbs.db

# === 本地依赖与模型数据 ===
server/libs/
# 模型数据整体不入库（动辄几百 MB）。但要留一个例外：
# models/wakeword/*/keywords.txt 是**唤醒词的唯一真源** —— 开放词表方案下
# 改一行文本就能换唤醒词，这个文件必须跟着代码版本走，否则换台机器唤醒词就没了。
#
# 注意不能简单地保留 `server/models/` 再在下面加 `!`：git 的规则是
# 「父目录被排除后，其中的文件无法单独重新纳入」。必须先把目录本身放开
# （只放开目录、不放开文件），再把具体文件挑回来。
server/models/**
!server/models/**/
!server/models/wakeword/sherpa-onnx-kws-*/keywords.txt
# keywords_raw.txt 是给人类看/改的中文词源（一行一个唤醒词），
# keywords.txt 是它编译出的拼音 token 产物。两个都要入库，缺了前者换机器就改不了词。
!server/models/wakeword/sherpa-onnx-kws-*/keywords_raw.txt
server/data/
pyaudio_pkg/

# === 诊断与临时脚本 ===
diagnose_mic.py
download_whisper.py
dump_deps.py
inspect_db.py
scripts/backup_db.py
scripts/decrypt_db.py

# === 运行时临时文件 ===
server/*.err
server/*.out
server/*.startup.err
server/db_check*.txt
NUL

# === 临时测试文件 ===
server/test_large.wav
server/mic_test.wav

# === 本地数据库备份与损坏残留（含私人对话记录，绝不入库）===
server/_bak_*/
server/_db_backup_*/
server/_dbbak-*/
server/*.db.corrupt
server/*.db-wal.broken
server/*.db-shm.broken
server/tmp_db_dump.sql
